# Переменные окружения хаба. На Dockhost — панель проекта → «Переменные окружения».
# Локально: cp .env.example .env, заполнить, затем  set -a; . ./.env; set +a

# МойСклад: токен сотрудника с правами на отгрузки, печать и доп. поля
# (МойСклад → Настройки → Пользователи → сотрудник → «Токены» или POST /security/token)
MOYSKLAD_TOKEN=

# 1 — ничего не отправлять, только журнал (так начинать!); 0 — боевой режим
HUB_DRY_RUN=1

# REST API хаба: ключ для заголовка X-Api-Key (любая длинная случайная строка)
HUB_API_KEY=
# секрет в адресе вебхука: https://<домен>/hooks/moysklad/<секрет>
HUB_WEBHOOK_SECRET=
# внешний адрес хаба (домен Dockhost), нужен для python -m hub webhooks install
HUB_PUBLIC_URL=

# страховочный опрос отгрузок, секунд (0 — только вебхуки)
HUB_POLL_SECONDS=300
# при самом первом старте подхватить изменения за столько часов назад (0 — только новые)
HUB_LOOKBACK_HOURS=0
# база хаба; на Dockhost — путь на постоянном диске, иначе после релиза журнал обнулится
HUB_DB=/data/hub.sqlite3

# Почта (пример — Яндекс 360: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=0

# Telegram: бот для отправки файлов и алертов
TELEGRAM_BOT_TOKEN=
# chat_id, куда писать, если автоматизация сдалась после всех повторов
HUB_ALERT_CHAT=
